# Copy to .env on the VPS (never commit .env; the repo is public).

# DeepSeek (OpenAI-compatible API). Put your own key here on the server only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set to the DeepSeek "flash" model name shown in your DeepSeek console.
DEEPSEEK_MODEL=deepseek-flash

# WooCommerce REST (WP user + Application Password, or WC consumer key/secret)
WOO_URL=https://ecocart.co.in
WOO_USER=
WOO_APP_PASSWORD=

# WhatsApp numbers allowed to control Eco with "hey eco" (country code, digits only, comma separated)
OWNER_NUMBERS=917012045854

# Website chat endpoint
WEB_PORT=8795
WEB_ALLOWED_ORIGIN=https://ecocart.co.in

# Daily report time (24h, Asia/Kolkata)
REPORT_HOUR=21
WA_PHONE=917012145854
LINK_TOKEN=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
